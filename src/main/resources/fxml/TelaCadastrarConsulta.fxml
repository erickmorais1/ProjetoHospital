<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="br.edu.ufersa.ProjetoHospital.Controller.CadastrarConsultaController"
      alignment="CENTER"
      spacing="15">

    <Button fx:id="btnCadastrar"
            text="Cadastrar"
            onAction="#cadastrarConsulta"/>

    <TextField fx:id="txtIdConsulta"
               promptText="ID da Consulta"/>

    <DatePicker fx:id="dpDataConsulta"/>


    <Button fx:id="btnVoltar"
            text="Voltar"/>

</VBox>