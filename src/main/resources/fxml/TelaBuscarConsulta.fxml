<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="650.0" prefWidth="900.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.edu.ufersa.ProjetoHospital.Controller.BuscarConsultaController">
   <top>
      <VBox prefHeight="80.0" prefWidth="900.0" style="-fx-background-color: #2E86AB;" BorderPane.alignment="CENTER">
         <children>
            <Label text="BUSCAR CONSULTA" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="20.0" />
               </font>
               <VBox.margin>
                  <Insets bottom="10.0" left="20.0" top="15.0" />
               </VBox.margin>
            </Label>
            <Label text="Pesquise consultas por ID, CPF do paciente ou CRM do médico" textFill="#E0E0E0">
               <font>
                  <Font size="12.0" />
               </font>
               <VBox.margin>
                  <Insets left="20.0" />
               </VBox.margin>
            </Label>
         </children>
      </VBox>
   </top>
   <center>
      <VBox spacing="15.0" BorderPane.alignment="CENTER">
         <children>
            <HBox spacing="10.0" alignment="CENTER_LEFT">
               <children>
                  <TextField fx:id="txtId" promptText="ID da consulta"
                             prefWidth="220.0" style="-fx-font-size: 13;" />
                  <Button onAction="#buscarPorId"
                          style="-fx-padding: 10; -fx-font-size: 12;"
                          text="Buscar por ID" />
               </children>
            </HBox>
            <HBox spacing="10.0" alignment="CENTER_LEFT">
               <children>
                  <TextField fx:id="txtCpf" promptText="CPF do paciente"
                             prefWidth="220.0" style="-fx-font-size: 13;" />
                  <Button onAction="#buscarPorCpf"
                          style="-fx-padding: 10; -fx-font-size: 12;"
                          text="Buscar por CPF" />
               </children>
            </HBox>
            <HBox spacing="10.0" alignment="CENTER_LEFT">
               <children>
                  <TextField fx:id="txtCrm" promptText="CRM do médico"
                             prefWidth="220.0" style="-fx-font-size: 13;" />
                  <Button onAction="#buscarPorMedico"
                          style="-fx-padding: 10; -fx-font-size: 12;"
                          text="Buscar por Médico" />
               </children>
            </HBox>
            <TableView fx:id="tabelaConsultas" prefHeight="350.0" prefWidth="860.0">
               <columns>
                  <TableColumn fx:id="colId" prefWidth="60.0" text="ID" />
                  <TableColumn fx:id="colPaciente" prefWidth="180.0" text="Paciente" />
                  <TableColumn fx:id="colMedico" prefWidth="180.0" text="Médico" />
                  <TableColumn fx:id="colData" prefWidth="120.0" text="Data" />
                  <TableColumn fx:id="colStatus" prefWidth="120.0" text="Status" />
                  <TableColumn fx:id="colObservacao" prefWidth="200.0" text="Observação" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
         <padding>
            <Insets bottom="10.0" left="20.0" right="20.0" top="20.0" />
         </padding>
      </VBox>
   </center>
   <bottom>
      <HBox alignment="CENTER_RIGHT" spacing="10.0" style="-fx-padding: 20;" BorderPane.alignment="CENTER">
         <children>
            <Button minWidth="100.0" onAction="#voltar"
                    style="-fx-padding: 10; -fx-font-size: 12;"
                    text="Voltar" />
         </children>
      </HBox>
   </bottom>
</BorderPane>
