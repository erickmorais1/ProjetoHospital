<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.edu.ufersa.ProjetoHospital.Controller.ListarMedicosController">
   <top>
      <VBox prefHeight="80.0" prefWidth="900.0" style="-fx-background-color: #2E86AB;" BorderPane.alignment="CENTER">
         <children>
            <Label text="LISTAR MÉDICOS" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="20.0" />
               </font>
               <VBox.margin>
                  <Insets bottom="10.0" left="20.0" top="15.0" />
               </VBox.margin>
            </Label>
            <HBox spacing="20.0">
               <children>
                  <Label fx:id="lblTotalMedicos" text="Total de médicos: 0" textFill="#E0E0E0">
                     <font>
                        <Font size="12.0" />
                     </font>
                  </Label>
               </children>
               <VBox.margin>
                  <Insets left="20.0" />
               </VBox.margin>
            </HBox>
         </children>
      </VBox>
   </top>
   <center>
      <TableView fx:id="tabelaMedicos" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
        <columns>
          <TableColumn fx:id="colNome" prefWidth="200.0" text="Nome" />
          <TableColumn fx:id="colCpf" prefWidth="150.0" text="CPF" />
            <TableColumn fx:id="colCrm" prefWidth="150.0" text="CRM" />
            <TableColumn fx:id="colValorConsulta" prefWidth="100.0" text="Valor Consulta" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </center>
   <bottom>
      <HBox alignment="CENTER_RIGHT" spacing="10.0" style="-fx-padding: 20;" BorderPane.alignment="CENTER">
         <children>
            <Button fx:id="btnAtualizar" minWidth="100.0" onAction="#atualizarMedico" style="-fx-padding: 10; -fx-font-size: 12;" text="Atualizar" />
            <Button fx:id="btnRemover" minWidth="100.0" onAction="#removerMedico" style="-fx-padding: 10; -fx-font-size: 12;" text="Remover" />
            <Button minWidth="100.0" onAction="#voltar" style="-fx-padding: 10; -fx-font-size: 12;" text="Voltar" />
         </children>
      </HBox>
   </bottom>
</BorderPane>
