<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="br.edu.ufersa.ProjetoHospital.Controller.TelaPacienteController"
      alignment="CENTER"
      spacing="15"
      style="-fx-background-color: #f8f9fa;">

    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <Label text="Área do Paciente"
           style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <HBox alignment="CENTER" spacing="10">
        <TextField fx:id="txtCpfBusca" promptText="Digite o seu CPF"/>
        <Button text="Acessar Meu Prontuário" onAction="#acessarProntuario"/>
    </HBox>

    <VBox fx:id="panelDados" spacing="10" alignment="CENTER_LEFT" visible="false"
          style="-fx-border-color: #ced4da; -fx-border-radius: 5;
                 -fx-padding: 15; -fx-background-color: white;">

        <Label text="Dados Pessoais"
               style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
        <Label fx:id="lblNome"  text="Nome: "/>
        <Label fx:id="lblCpf"   text="CPF: "/>
        <Label fx:id="lblRua"   text="Endereço (Rua): "/>

        <Separator/>

        <Label text="Informações do Prontuário"
               style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
        <Label fx:id="lblDataProntuario" text="Data de Abertura: "/>
        <Label fx:id="lblObservacoes"    text="Observações: " wrapText="true"/>
    </VBox>

    <HBox alignment="CENTER" spacing="10">
        <Button text="Cadastrar Paciente" onAction="#irParaCadastro"/>
        <Button text="Voltar ao Início"   onAction="#voltar"/>
    </HBox>

</VBox>
