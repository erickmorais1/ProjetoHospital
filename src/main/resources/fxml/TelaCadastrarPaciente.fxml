<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="20" xmlns:fx="http://javafx.com/fxml"
      fx:controller="br.edu.ufersa.ProjetoHospital.Controller.CadastrarPacienteController"
      style="-fx-background-color: #f4f4f4;">

    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <Label text="Cadastro de Paciente" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="10" alignment="CENTER">
        <Label text="Nome:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="txtNome" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label text="CPF:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="txtCpf" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

        <Label text="Rua:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <TextField fx:id="txtRua" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

        <Label text="Observações:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <TextArea fx:id="txtObs" prefHeight="80" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
    </GridPane>

    <HBox spacing="15" alignment="CENTER">
        <Button text="Salvar" onAction="#salvarPaciente" style="-fx-background-color: #2ecc71; -fx-text-fill: white;"/>
        <Button text="Voltar" onAction="#voltar" style="-fx-background-color: #e74c3c; -fx-text-fill: white;"/>
    </HBox>
</VBox>
