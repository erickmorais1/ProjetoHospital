<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="600.0" prefWidth="800.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.edu.ufersa.ProjetoHospital.Controller.MenuMedicoController">
   <top>
      <VBox prefHeight="100.0" prefWidth="800.0" style="-fx-background-color: #2E86AB;" BorderPane.alignment="CENTER">
         <children>
            <Label text="SISTEMA HOSPITALAR - ÁREA DO MÉDICO" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
               <VBox.margin>
                  <Insets bottom="10.0" left="20.0" right="20.0" top="20.0" />
               </VBox.margin>
            </Label>
            <Label text="Gerenciamento de Consultas" textFill="#E0E0E0">
               <font>
                  <Font size="14.0" />
               </font>
               <VBox.margin>
                  <Insets bottom="15.0" left="20.0" />
               </VBox.margin>
            </Label>
         </children>
      </VBox>
   </top>
   <center>
      <VBox alignment="CENTER" spacing="20.0" BorderPane.alignment="CENTER">
         <children>
            <Label text="Escolha uma opção:">
               <font>
                  <Font size="18.0" />
               </font>
            </Label>
            <HBox alignment="CENTER" spacing="15.0">
               <children>
                  <Button fx:id="btnCadastrarConsulta" minHeight="100.0" minWidth="160.0"
                          onAction="#abrirCadastrarConsulta"
                          style="-fx-font-size: 14; -fx-text-alignment: CENTER;"
                          text="Cadastrar&#10;Consulta" />
                  <Button minHeight="100.0" minWidth="160.0"
                          onAction="#abrirBuscarConsulta"
                          style="-fx-font-size: 14; -fx-text-alignment: CENTER;"
                          text="Buscar&#10;Consulta" />
                  <Button minHeight="100.0" minWidth="160.0"
                          onAction="#abrirListarConsultas"
                          style="-fx-font-size: 14; -fx-text-alignment: CENTER;"
                          text="Listar&#10;Consultas" />
               </children>
            </HBox>
            <HBox alignment="CENTER" spacing="15.0">
               <children>
                  <Button minHeight="100.0" minWidth="160.0"
                          onAction="#abrirRemoverConsulta"
                          style="-fx-font-size: 14; -fx-text-alignment: CENTER;"
                          text="Remover&#10;Consulta" />
                  <Button minHeight="100.0" minWidth="160.0"
                          onAction="#abrirObservacao"
                          style="-fx-font-size: 14; -fx-text-alignment: CENTER;"
                          text="Adicionar&#10;Observação" />
                  <Button minHeight="100.0" minWidth="160.0"
                          onAction="#sair"
                          style="-fx-font-size: 14; -fx-text-alignment: CENTER;"
                          text="Sair" />
               </children>
            </HBox>
         </children>
         <padding>
            <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
         </padding>
      </VBox>
   </center>
</BorderPane>
