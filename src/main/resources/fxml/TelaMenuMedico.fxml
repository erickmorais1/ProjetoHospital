<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="br.edu.ufersa.ProjetoHospital.Controller.MenuMedicoController"
      alignment="CENTER"
      spacing="15">

    <Label text="Área do Médico"/>

    <Button fx:id="btnCadastrarConsulta"
            text="Cadastrar Consulta"
            onAction="#abrirCadastrarConsulta"/>

    <Button text="Buscar Consulta"
            onAction="#abrirBuscarConsulta"/>

    <Button text="Listar Consultas"
            onAction="#abrirListarConsultas"/>

    <Button text="Remover Consulta"
            onAction="#abrirRemoverConsulta"/>

    <Button text="Adicionar Observação"
            onAction="#abrirObservacao"/>

    <Button text="Sair"
            onAction="#sair"/>

</VBox>