<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
       fx:controller="br.edu.ufersa.ProjetoHospital.Controller.TelaInicialController"
       alignment="CENTER"
       spacing="15">

    <Label text="Sistema Hospitalar"/>

    <Button fx:id="btnFuncionario"
            text="Sou Funcionário"
            onAction="#irParaLogin"/>

    <Button fx:id="btnPaciente"
            text="Sou Paciente"
            onAction="#irParaPaciente"/>

</VBox>